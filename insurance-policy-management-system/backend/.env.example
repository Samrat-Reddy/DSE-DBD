# Copy to backend/.env and fill in real values. backend/.env is git-ignored.

APP_NAME="Insurance Policy Management System API"
# development | test | production
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# MySQL connection (PyMySQL driver). URL-encode special characters in the
# password, e.g. "@" -> %40, "#" -> %23, "%" -> %25.
DATABASE_URL=mysql+pymysql://ipms_app:CHANGE_ME@127.0.0.1:3306/ipms

# Connection pool (defaults suit a single developer / demo).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
# true logs every SQL statement - development only
DB_ECHO=false

# JWT access tokens. The secret must be at least 32 characters, random and
# different per environment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=ipms-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only for pytest's MySQL integration tests. Use a separate, disposable schema:
# the tests create and drop their own tables in it.
# TEST_DATABASE_URL=mysql+pymysql://ipms_app:CHANGE_ME@127.0.0.1:3306/ipms_test
