# Base URL of the FastAPI backend. Copy this file to `.env` and adjust per environment.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout in milliseconds.
VITE_API_TIMEOUT=15000

# DEVELOPMENT ONLY — lets the demo-role switcher sign in to the backend as the
# matching seeded dev account (admin@/agent@/policyholder@example.com). Put the
# value in `.env.development.local` (git-ignored), never in a committed file.
# It is ignored in production builds. See backend/README.md "Development credentials".
# VITE_DEMO_AUTH_PASSWORD=
